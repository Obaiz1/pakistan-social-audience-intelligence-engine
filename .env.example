# Copy to .env (git-ignored) and fill in only what you need. The app runs with NONE of these set:
# it then serves the committed, clearly labelled SYNTHETIC demo dataset.

# --- Runtime ---
# local | production. Production/hosted mode is read-only for shared data.
APP_ENV=local
# 1 = refuse writes that would change shared datasets (set automatically on Vercel).
AUDIENCEIQ_HOSTED=
# 1 = allow dataset regeneration / persistent imports even when hosted (needs a durable store).
AUDIENCEIQ_ALLOW_WRITES=
# Upload limit for CSV imports, in bytes (default 2 MB; Vercel's hard body limit is 4.5 MB).
AUDIENCEIQ_MAX_UPLOAD_BYTES=2097152
# Where local imports are persisted (default: ./var).
AUDIENCEIQ_VAR_DIR=

# --- Frontend (local dev only) ---
# Where `next dev` proxies /api/v1/* (default http://127.0.0.1:8000). Not used on Vercel.
API_ORIGIN=

# --- Optional observed-data collection (offline pipeline, never needed by the web app) ---
# YouTube Data API v3 key (Google Cloud Console). Used only by pipelines/collect_youtube.py.
YOUTUBE_API_KEY=

# --- Optional AI wording of recommendations (local only; off by default; numbers are locked) ---
NVIDIA_API_KEY=
# Optional model id on the NVIDIA API Catalog (default: nvidia/nemotron-3-super-120b-a12b, as used in Project 1).
NVIDIA_MODEL=
AUDIENCEIQ_ENABLE_LLM=
